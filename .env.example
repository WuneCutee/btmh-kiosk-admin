# Kiosk Admin - Environment Configuration
# Copy file nay thanh .env va dien gia tri that (KHONG commit .env)

# Server
SERVER_PORT=8090

# Database (CUNG database Postgres voi Backend/webview - localdb, doc/ghi thang bang
# kiosk_device / kiosk_activation_code / kiosk_ad da co san, khong qua Feign)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=localdb
DB_USER=devbtmh
DB_PASSWORD=changeme

# JWT rieng cho app nay - KHONG dung chung secret voi webview/admin-portal
KIOSK_JWT_SECRET=changeme-please-generate-a-random-secret-at-least-32-bytes-long
KIOSK_JWT_EXPIRATION_MS=28800000

SHOW_SQL=false

# Datasource THU 2 - DB "gold_management" ma Backend/admin-portal dang dung. day la noi THUC SU
# chua bang product_prices (gia ban ra/mua vao) va la nha cua bang moi kiosk_admin_price_history
# (xem README phan "Kien truc / quyet dinh ky thuat" - tai sao can 2 database).
GOLD_DB_HOST=localhost
GOLD_DB_PORT=5432
GOLD_DB_NAME=gold_management
GOLD_DB_USER=gold_management
GOLD_DB_PASSWORD=changeme

# Ket noi sang Backend/admin-portal - kiosk-admin la HTTP CLIENT cua admin-portal cho
# product/category/inventory (xem AdminPortalClient). Tai khoan ky thuat nay PHAI da duoc cap
# quyen partner_code=KIOSK ben admin-portal truoc.
ADMIN_PORTAL_BASE_URL=http://localhost:8386
ADMIN_PORTAL_USERNAME=changeme
ADMIN_PORTAL_PASSWORD=changeme

# Ket noi sang Backend/webview - doc trang thai "online ngay bay gio" cua may kiosk
# (KioskSseConnectionRegistry). WEBVIEW_INTERNAL_SERVICE_KEY PHAI khop KIOSK_INTERNAL_SERVICE_KEY
# cua webview (xem KioskInternalAuthFilter ben webview - fail-closed neu sai/thieu).
WEBVIEW_BASE_URL=http://localhost:8080
WEBVIEW_INTERNAL_SERVICE_KEY=changeme

# Backend/kiosk-api - bao "catalog vua doi" de App cap nhat ngay (KIOSK_API_OPS_KEY = OPS_API_KEY cua kiosk-api)
KIOSK_API_BASE_URL=http://localhost:8091
KIOSK_API_OPS_KEY=changeme
